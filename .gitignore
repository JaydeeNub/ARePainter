# ---------------------------------------------------------------------------
# Game data. .layer exports are Bohemia Interactive content and tens of MB;
# never commit them. To ship a tiny hand-made fixture, whitelist it explicitly,
# e.g.  !tests/fixtures/tiny.layer
# ---------------------------------------------------------------------------
*.layer

# ---------------------------------------------------------------------------
# Generated masks, canopy textures and reports. Every output of this tool is a
# multi-megabyte PNG, so all PNGs are ignored; whitelist docs images with
# e.g.  !docs/*.png
# ---------------------------------------------------------------------------
*.png
output/
masks/
report*.json

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
build/
dist/
wheels/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test, type-check and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

